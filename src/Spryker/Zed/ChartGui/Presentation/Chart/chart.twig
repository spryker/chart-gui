{% block chartContent %}
    {% set chartView = chartView | default(data.view) %}

    <div class="chart d-flex flex-column flex-grow-1">
        {% block chartTitle %}
            {% if data.title %}
                <h4 class="chart__title mb-1">{{ data.title | trans }}</h4>
            {% endif %}
        {% endblock %}

        {% set chartPayload = {
            kind: chartKind | default('chart'),
            data: {
                key: data.key,
                title: data.title,
                view: chartView,
                traces: data.traces | map(trace => {
                    name: trace.name,
                    type: trace.type,
                    labels: trace.labels,
                    values: trace.values,
                    options: trace.options,
                }),
            },
        } %}
        {% block chartBody %}
            <div class="chart__body d-flex flex-column flex-grow-1" data-chart="{{ chartPayload | json_encode | e('html_attr') }}">
                {% block chartTemplates %}
                    {# The shared templates plus the ones of this chart's view. A view without a twig file keeps only the shared ones, and the chart script shows the error state. #}
                    {% include '@ChartGui/Chart/strategies/chart-strategy.twig' %}
                    {% include '@ChartGui/Chart/strategies/' ~ chartView ~ '-chart-strategy.twig' ignore missing %}
                {% endblock %}
            </div>
        {% endblock %}
    </div>
    {% block chartAssets %}
        {{ chartAssets() }}
    {% endblock %}
{% endblock %}
